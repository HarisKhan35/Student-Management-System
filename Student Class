package com.mycompany.main;

/**
 *
 * @author Global Computer M
 */
public class Student {
    private int std_id;
    private String std_name;
    private String stu_department;
    private int std_currentsem;
    
    public Student(int id,String name,String department,int semester){
        std_id = id;
        std_name = name;
        stu_department = department;
        std_currentsem = semester;
    }

    public int getStd_id() {
        return std_id;
    }

    public void setStd_id(int std_id) {
        this.std_id = std_id;
    }

    public String getStd_name() {
        return std_name;
    }

    public void setStd_name(String std_name) {
        this.std_name = std_name;
    }

    public String getStu_department() {
        return stu_department;
    }

    public void setStu_department(String stu_department) {
        this.stu_department = stu_department;
    }

    public int getStd_currentsem() {
        return std_currentsem;
    }

    public void setStd_currentsem(int std_currentsem) {
        this.std_currentsem = std_currentsem;
    }
    
 @Override
 public String toString(){
     return String.format("Student id: %d\nStudent Name: %s\nStudent Department: %s\nStudent Current Semester: %d\n",std_id,std_name,stu_department,std_currentsem);
 }
}
